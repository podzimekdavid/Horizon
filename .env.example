# Copy to .env. Replace every value for staging or production.
# Local `npm run db:start` fills the auth URLs when they are unset.
# `npm run db:push` refuses to run until the deploy values are set.

# Auth redirects pushed with the Supabase config. One value per environment.
HORIZON_AUTH_SITE_URL=http://127.0.0.1:3000
HORIZON_AUTH_ADDITIONAL_REDIRECT_URL=http://127.0.0.1:3000

# Hosted project. Empty locally. Required by npm run db:push.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=

# Event CLI. The publishable key is public; take it from `npx supabase status`
# locally, or from the target project's API settings in CI.
HORIZON_SUPABASE_URL=http://127.0.0.1:54321
HORIZON_SUPABASE_PUBLISHABLE_KEY=
HORIZON_EMAIL=agent@horizon.local
HORIZON_PASSWORD=horizon-local-dev
HORIZON_ORG_ID=00000000-0000-4000-8000-000000000001
