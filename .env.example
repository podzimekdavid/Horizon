# CLI against the Compose stack. The API key is ANON_KEY in docker/.env
# (or SUPABASE_PUBLISHABLE_KEY after utils/add-new-auth-keys.sh).
# Point SUPABASE_PUBLIC_URL in docker/.env at this host, locally or on a server.

HORIZON_SUPABASE_URL=http://localhost:8000
HORIZON_SUPABASE_PUBLISHABLE_KEY=
HORIZON_EMAIL=member@horizon.local
HORIZON_PASSWORD=horizon-local-dev
HORIZON_ORG_ID=00000000-0000-4000-8000-000000000001
